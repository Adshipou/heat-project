<div class="meeting-container">
  <%= render @meeting %>
</div>

<div class="meeting-actions">
  <% if admin_view_mode? %>
    <%= link_to "Edit this meeting", edit_meeting_path(@meeting), class: "event-link" %>
  <% end %>
  <%= link_to "Back to meetings", meetings_path, class: "back-link" %>

  <% if admin_view_mode? %>
    <%= button_to "Delete this meeting", @meeting, method: :delete, class: "btn btn-danger" %>
  <% end %>
</div>

