<div id="<%= dom_id meeting %>" class="record-card">
  <p>
    <strong>Name:</strong>
    <%= meeting.name %>
    <span class="record-sep">|</span>
    <strong>Date:</strong>
    <%= meeting.date %>
    <span class="record-sep">|</span>
    <strong>Time:</strong>
    <%= meeting.time %>
    <span class="record-sep">|</span>
    <strong>Location:</strong>
    <%= meeting.location %>
  </p>
  <p>
    <strong>Description:</strong>
    <%= meeting.description %>
  </p>
</div>
