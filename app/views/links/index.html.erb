<!-- app/views/links/index.html.erb -->

<%= link_to 'Back', root_path, class: "back-link" %>

<h1>Links</h1>

<div id="links">
  <% @links.each do |link| %>
    <%= render link %>
    <% if admin_view_mode? %>
      <p>
        <%= link_to "Show this link", link, class: "event-link" %>
      </p>
    <% end %>
  <% end %>
</div>

<% if admin_view_mode? %>
  <%= link_to "New link", new_link_path, class: "new-event-link" %>
<% end %>

