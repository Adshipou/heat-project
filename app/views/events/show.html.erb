<div class="event-details">
  <%= render @event %>
</div>

<div class="event-actions">
  <% if admin_view_mode? %>
    <%= link_to "Edit this event", edit_event_path(@event), class: "event-link" %>
  <% end %>
  <%= link_to "Back to events", events_path, class: "back-link" %>

  <% if admin_view_mode? %>
    <%= button_to "Destroy this event", @event, method: :delete, form: { class: "inline-form" }, class: "btn btn-danger" %>
  <% end %>
</div>

