<div id="<%= dom_id event %>" class="record-card">
  <p>
    <strong>Event Link:</strong>
    <%= link_to event.event_link, external_url(event.event_link), target: "_blank", rel: "noopener" %>
  </p>

  <p>
    <strong>Event Name:</strong>
    <%= event.event_name %>
  </p>

  <p>
    <strong>Event Description:</strong>
    <%= event.event_description %>
  </p>

  <p>
    <strong>Event Deadline:</strong>
    <%= event.event_end.strftime("%A, %d %B %Y at %I:%M %p") %>
  </p>

  <p>
    <strong>Event Start:</strong>
    <%= event.event_datetime.strftime("%A, %d %B %Y at %I:%M %p") %>
  </p>

  <p>
    <strong>Event Points:</strong>
    <%= event.event_points %>
  </p>
</div>
