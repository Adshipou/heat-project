<%= link_to 'Back', root_path, class: 'back-link' %>

<h1>Events</h1>

<div id="events">
  <% @events.each do |event| %>
    <div class="event">
      <%= render event %>
      <% if admin_view_mode? %>
        <p>
          <%= link_to "Show this event", event, class: 'event-link' %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>

<% if admin_view_mode? %>
  <%= link_to "New event", new_event_path, class: 'new-event-link' %>
<% end %>

