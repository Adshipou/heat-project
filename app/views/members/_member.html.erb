<div id="<%= dom_id member %>" class="record-card">
  <p>
    <strong>Member name:</strong>
    <%= member.member_name %>
  </p>

  <p>
    <strong>Member points:</strong>
    <%= member.member_points %>
  </p>

  <p>
    <strong>Executive status:</strong>
    <span class="<%= 'executive-status-' + member.executive_status.to_s %>">
      <%= member.executive_status ? 'Yes' : 'No' %>
    </span>
  </p>
</div>
