<%= link_to 'Back', root_path, class: 'back-link' %>

<p class="notice"><%= notice %></p>

<h1>Members</h1>

<div id="members">
  <% @members.each do |member| %>
    <div class="member-item">
      <%= render member %>
      <div class="member-action">
        <%= link_to "Show this member", member, class: "event-link" %>
      </div>
    </div>
  <% end %>
</div>

