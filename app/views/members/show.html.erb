<p class="notice"><%= notice %></p>

<div class="member-details">
  <%= render @member %>
</div>

<div class="action-links">
  <% if admin_view_mode? %>
    <%= link_to "Edit this member", edit_member_path(@member), class: "event-link" %>
  <% end %>
  <%= link_to "Back to members", members_path, class: "back-link" %>
  <% if admin_view_mode? %>
    <%= button_to "Destroy this member", @member, method: :delete, data: { confirm: "Are you sure?" }, form_class: "action-link", class: "btn btn-danger" %>
  <% end %>
</div>

<div class="meetings-attended">
  <h3>Meetings Attended</h3>
  <% if @member.meetings.any? %>
    <ul>
      <% @member.meetings.each do |meeting| %>
        <li><%= meeting.name %></li>
      <% end %>
    </ul>
  <% else %>
    <p>This member has not attended any meetings yet.</p>
  <% end %>
</div>

<div class="events-attended">
  <h3>Events Attended</h3>
  <% if @member.events.any? %>
    <ul>
      <% @member.events.each do |event| %>
        <li><%= event.event_name %></li>
      <% end %>
    </ul>
  <% else %>
    <p>This member has not attended any events yet.</p>
  <% end %>
</div>

