<%= link_to "Back to Home", root_path, class: "back-link" %>

<h1 class="attendance-page-title">Attendance for <%= current_user&.full_name || "Member" %></h1>

<div class="attendance-layout">
  <section class="meetings-attended">
    <h3>Meetings Attended</h3>
    <% if @member && @member.meetings.any? %>
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Name</th>
          </tr>
        </thead>
        <tbody>
          <% @member.meetings.each do |meeting| %>
            <tr>
              <td><%= meeting.date.strftime("%b %d, %Y") %></td>
              <td><%= meeting.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><%= @member ? "This member has not attended any meetings yet." : "Member is not in the system." %></p>
    <% end %>
  </section>

  <section class="events-attended">
    <h3>Events Attended</h3>
    <% if @member && @member.events.any? %>
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Name</th>
          </tr>
        </thead>
        <tbody>
          <% @member.events.each do |event| %>
            <tr>
              <td><%= event.event_datetime.strftime("%b %d, %Y %I:%M %p") %></td>
              <td><%= event.event_name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><%= @member ? "This member has not attended any events yet." : "Member is not in the system." %></p>
    <% end %>
  </section>
</div>

<section class="member-points-card">
  <h3>Total Points</h3>
  <p class="member-points-value"><%= @member ? @member.member_points : 0 %></p>
</section>
