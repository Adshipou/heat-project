<!DOCTYPE html>
<html>

<head>
  <title>HEAT</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Include Bootstrap CSS -->
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom Styles -->
  <style>
    .container.mt-4 {
      max-width: 1080px;
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
      <%= link_to "Home page", root_path, class: "navbar-brand" %>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <%= link_to "Links", links_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Events", events_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Meetings", meetings_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to(admin_view_mode? ? "Event Attendance" : "Event Check-In", events_members_path, class: "nav-link") %>
          </li>
          <li class="nav-item">
            <%= link_to(admin_view_mode? ? "Meeting Attendance" : "Meeting Check-In", meetings_members_path, class: "nav-link") %>
          </li>
          <% if admin_view_mode? %>
            <li class="nav-item">
              <%= link_to "Members", members_path, class: "nav-link" %>
            </li>
          <% end %>
        </ul>
      </div>
      <div class="ml-auto">
        <% if current_user %>
        <% if admin_user? %>
          <div style="margin-bottom: 8px; text-align: right;">
            <span style="color: #fff; margin-right: 8px;"><%= admin_view_mode? ? "Admin View" : "Member View" %></span>
            <% if admin_view_mode? %>
              <%= button_to "Switch to Member View", switch_view_mode_path("member"), method: :post, class: "btn btn-success", style: "display:inline-block;" %>
            <% else %>
              <%= button_to "Switch to Admin View", switch_view_mode_path("admin"), method: :post, class: "btn btn-success", style: "display:inline-block;" %>
            <% end %>
          </div>
        <% end %>
        <div style="width: 75px; height: 75px; border-radius: 50%; overflow: hidden;">
          <%= link_to(check_member_attendance_path, onclick: "showEventsAndMeetings()") do %>
  <%= image_tag(current_user.avatar_url, style: "width: 100%; height: auto; border-radius: 50%; margin-bottom: 5px;") %>
<% end %>
        </div>
        <%= button_to "Logout", destroy_user_session_path(redirect_to: root_path), data: { turbo: "false" }, method: :delete, class: "btn btn-success" %>
        <% else %>
        <%= link_to "Login", new_user_session_path, class: "btn btn-success" %>
        <% end %>
        </div>
      </div>
    </div>
  </nav>

    <script>
  function showEventsAndMeetings() {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', '/check_member_attendance', true);
    xhr.onreadystatechange = function() {
      if (xhr.readyState === XMLHttpRequest.DONE) {
        if (xhr.status === 200) {
          var data = JSON.parse(xhr.responseText);
          if (data.attended) {
            document.querySelector('.meetings-attended').style.display = 'block';
            document.querySelector('.events-attended').style.display = 'block';
          } else {
            alert('This member has not attended any meetings or events yet.');
          }
        } else {
          alert('An error occurred while fetching member attendance.');
        }
      }
    };
    xhr.send();
  }
</script>

  <div class="container mt-4">
    <!-- Authotization message -->
    <div>
      <h5>Must enter password to gain access</h2>
    </div></br></br>

    <!-- Admin Login button -->
    <div>
      <h2 class="mb-3">Admin Login</h2>
      <%= form_with url: login_path, local: true do |form| %>
        <div class="form-group">
          <%= form.label :password %> <br>
          <%= form.password_field :password %>
        </div>
        <div>
          <%= form.submit "Submit", class: "btn btn-primary" %>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <p class="text-danger"><%= flash[:alert] %></p>
      <% end %>
    </div>
  </div>

  <!-- Include Bootstrap JS and jQuery for modal functionality -->
  <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

 

</body>

</html>

